[run]
source = app
branch = True
omit = 
    app/__pycache__/*
    app/*/migrations/*
    tests/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
fail_under = 70
show_missing = True
precision = 2

[html]
directory = htmlcov
