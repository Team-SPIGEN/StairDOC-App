ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:52793

# Application settings
DEBUG=false

# Redis configuration (optional - falls back to local cache if not set)
# REDIS_URL=redis://localhost:6379/0

# Database pool settings for high throughput
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# Rate limiting settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Logging settings
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_REQUESTS=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# API Key authentication (comma-separated list for service-to-service calls)
# API_KEYS=key1,key2,key3

# Request size limits (in bytes)
MAX_REQUEST_SIZE=1048576
MAX_UPLOAD_SIZE=10485760
