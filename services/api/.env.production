# =============================================================================
# StairDOC API - Production Configuration
# =============================================================================
# IMPORTANT: Never commit this file with real values to version control!
# Copy this to .env and fill in secure values before deployment.
# =============================================================================

# -----------------------------------------------------------------------------
# SECURITY - MUST CHANGE FOR PRODUCTION
# -----------------------------------------------------------------------------
# Generate a new secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_SECURE_64_CHARACTER_HEX_STRING

# JWT Token expiration (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL recommended for production
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://stairdoc:CHANGE_PASSWORD@localhost:5432/stairdoc_prod

# Connection pool settings (tune based on server resources)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# -----------------------------------------------------------------------------
# REDIS (Required for production - caching & rate limiting)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=WARNING
LOG_FORMAT=json
LOG_REQUESTS=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false

# -----------------------------------------------------------------------------
# CORS - Add your production frontend domains
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=https://stairdoc.yourdomain.com,https://app.stairdoc.yourdomain.com

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# -----------------------------------------------------------------------------
# API KEYS (for service-to-service authentication)
# -----------------------------------------------------------------------------
# Generate keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=CHANGE_ME_KEY_1,CHANGE_ME_KEY_2

# -----------------------------------------------------------------------------
# REQUEST LIMITS
# -----------------------------------------------------------------------------
MAX_REQUEST_SIZE=1048576
MAX_UPLOAD_SIZE=10485760

# -----------------------------------------------------------------------------
# EXTERNAL SERVICES (optional)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=CHANGE_ME
# SMTP_FROM=StairDOC <noreply@yourdomain.com>

# Firebase Cloud Messaging (for push notifications)
# FCM_SERVER_KEY=CHANGE_ME

# Sentry (error tracking)
# SENTRY_DSN=https://xxxx@sentry.io/xxxx
